# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

# Vercel
vercel_api_token = "<vercel-api-token>"
# vercel_team_id = "<team-slug-or-id>"

# Supabase
supabase_access_token      = "<supabase-personal-access-token>"
supabase_organization_id   = "<supabase-organization-slug>"
supabase_database_password = "<strong-database-password>"

# Optional overrides
# vercel_project_name    = "its-biomed-calendar"
# supabase_project_name  = "its-biomed-calendar"
# supabase_region        = "eu-central-1"
# supabase_instance_size = "micro"
